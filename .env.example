# Used by the Next.js API routes during local development.
OCR_ENDPOINT=http://localhost:8080

# Disable Next.js telemetry for local runs.
NEXT_TELEMETRY_DISABLED=1

# Optional host port for the Compose debug proxy.
OCR_HOST_PORT=8081

# Inference backend. The default uses the llama.cpp server started by the OCR
# container. Use vllm when connecting to an external OpenAI-compatible server.
SURYA_INFERENCE_BACKEND=llamacpp
# SURYA_INFERENCE_URL=http://host.docker.internal:8000/v1
# SURYA_INFERENCE_BACKEND=vllm

# Client-side concurrency for inference requests.
SURYA_INFERENCE_PARALLEL=4

# GPU profile settings. Keep these values unchanged until VRAM usage has been
# measured on the target machine.
SURYA_INFERENCE_CTX_PER_SLOT=12288
SURYA_MAX_TOKENS_FULL_PAGE=8192
SURYA_MAX_TOKENS_BLOCK_CEILING=4096
SURYA_MAX_TOKENS_TABLE_REC=2048

# OCR request limits. Blank values use the backend defaults.
# INFERENCE_CONCURRENCY=4
MAX_PAGES=50
# CHUNK_SIZE=8
MAX_QUEUE_DEPTH=4

# Optional cache maintenance. Zero or unset keeps cache entries indefinitely.
# RESULT_CACHE_TTL_SECONDS=0
# RESULT_CACHE_MAX_BYTES=0
# CLEANUP_INTERVAL_SECONDS=60

# Temporary document handle lifetime and table item extraction.
DOCUMENT_TTL_SECONDS=3600
TABLE_ITEMS_ENABLED=1
